# =============================================================================
# BIVVO CHECKOUT - VARIÁVEIS DE AMBIENTE
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Frontend)
# Obtenha em: https://supabase.com/dashboard/project/[seu-projeto]/settings/api
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...
VITE_SUPABASE_PROJECT_ID=seu-projeto-id

# -----------------------------------------------------------------------------
# DOMÍNIO (para Traefik)
# -----------------------------------------------------------------------------
DOMAIN=checkout.seudominio.com.br

# =============================================================================
# SECRETS DO SUPABASE (configurar nas Edge Functions)
# =============================================================================
# Estes valores devem ser configurados diretamente no Supabase Dashboard:
# https://supabase.com/dashboard/project/[seu-projeto]/settings/functions
#
# ASAAS_API_KEY=sua_api_key_do_asaas
# ASAAS_BASE_URL=https://api.asaas.com/v3 (produção) ou https://sandbox.asaas.com/api/v3
# ASAAS_WEBHOOK_TOKEN=token_opcional_para_validar_webhooks
#
# Os seguintes são configurados automaticamente pelo Supabase:
# - SUPABASE_URL
# - SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
# =============================================================================
